{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Team-Riley-Web/wisdom-plugin-maps/schema/catalog-entry.schema.json",
  "title": "Free plug-in catalog entry",
  "description": "One curated free, open-licence plug-in a host can offer to install: where the author publishes each platform's build, pinned by size and SHA-256, and how it installs. Format 1. Entries are TOML in catalog/; this schema checks them after TOML is read. Nothing is re-hosted: every URL is the author's own release or official site.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name",
    "author",
    "category",
    "license",
    "source",
    "summary",
    "formats",
    "stars",
    "selected",
    "downloads"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The file name without .toml."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "eq",
        "dynamics",
        "de_esser",
        "reverb",
        "delay",
        "modulation",
        "saturation",
        "pitch",
        "utility",
        "instrument"
      ],
      "description": "Where a host lists it (the plug-in type colours, instruments together)."
    },
    "also": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "eq",
          "dynamics",
          "de_esser",
          "reverb",
          "delay",
          "modulation",
          "saturation",
          "pitch",
          "utility",
          "instrument"
        ]
      },
      "description": "Other categories it covers (a multi-effect)."
    },
    "instrument": {
      "enum": [
        "synth",
        "sampler",
        "drums"
      ],
      "description": "Instruments only: which kind."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "The SPDX id of the licence in the author's repository."
    },
    "source": {
      "type": "string",
      "pattern": "^https://",
      "description": "The author's source repository."
    },
    "site": {
      "type": "string",
      "pattern": "^https://",
      "description": "The author's official site, when the builds come from it."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One line, in our own words."
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "vst3",
          "au",
          "clap",
          "standalone"
        ]
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.toml$"
      },
      "description": "Its plug-in maps in maps/."
    },
    "stars": {
      "type": "integer",
      "minimum": 0,
      "description": "GitHub stars of the source repository at selection."
    },
    "selected": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "When it was selected or last re-ranked."
    },
    "exception": {
      "type": "string",
      "minLength": 1,
      "description": "Why it is listed although it misses a selection rule (CURATION.md)."
    },
    "downloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "version",
          "url",
          "origin",
          "sha256",
          "size",
          "archive",
          "install"
        ],
        "properties": {
          "platform": {
            "enum": [
              "macos-universal",
              "macos-arm64",
              "macos-x86_64",
              "windows-x86_64"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "origin": {
            "enum": [
              "github-release",
              "official-site"
            ],
            "description": "Where the author publishes it."
          },
          "rolling": {
            "type": "boolean",
            "description": "The author replaces this build in place (a rolling release): the refresh script re-pins it."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "archive": {
            "enum": [
              "dmg",
              "zip",
              "tar.gz",
              "pkg",
              "exe",
              "msi"
            ]
          },
          "install": {
            "enum": [
              "unpack",
              "installer"
            ],
            "description": "unpack: copy the listed bundles into the per-user plug-in folders; installer: download, verify and open the author's installer for the user."
          },
          "bundles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\.(vst3|component|clap)$"
            },
            "description": "unpack only: the plug-in bundles' paths inside the archive."
          },
          "installer": {
            "type": "string",
            "pattern": "\\.(pkg|mpkg|exe|msi)$",
            "description": "installer only, when the archive is a dmg or zip: the installer's path inside it."
          },
          "signed": {
            "enum": [
              "notarized",
              "developer-id",
              "unsigned",
              "not-checked"
            ],
            "description": "macOS signing as checked at selection."
          }
        }
      }
    }
  }
}
